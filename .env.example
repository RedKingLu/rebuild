# rebuild 容器化环境变量示例 —— 复制为 .env 后按需填写。
# 安全红线（AGENTS.md §8/§12）：本文件只放“非敏感配置示例”；
# 真实密钥（LLM_API_KEY、各 Provider Key、Webhook URL、OAuth Secret）
# 只在本机 .env 中填写，.env 已被 .gitignore 保护，绝不提交、绝不写进镜像。

# ── 数据库 ──
# 默认 SQLite（见 backend/Dockerfile，无需在此设置）。
# 启用 PostgreSQL（docker compose --profile pg）时取消注释：
# REBUILD_DATABASE_URL=postgresql+psycopg://rebuild:rebuild@db:5432/rebuild
# POSTGRES_USER=rebuild
# POSTGRES_PASSWORD=__在本机填写__
# POSTGRES_DB=rebuild

# ── 跨域 / 前端地址（Settings env_prefix=REBUILD_）──
REBUILD_CORS_ORIGINS=http://localhost:8080
REBUILD_FRONTEND_URL=http://localhost:8080

# ── 模型 API Key（仅本机填写，示例占位）──
# 标准格式 {PROVIDER}_API_KEY；通用兜底 LLM_API_KEY（单 Provider 本地开发）。
# LLM_API_KEY=__在本机填写__
# DEEPSEEK_API_KEY=__在本机填写__

# ── BYOK 主密钥（凭据 AES-256-GCM 加密用）──
# REBUILD_MASTER_KEY=__在本机填写（缺省走开发派生，生产必须显式设置）__

# ── GitHub OAuth（可选，集成页代码托管用）──
# REBUILD_GITHUB_CLIENT_ID=__在本机填写__
# REBUILD_GITHUB_CLIENT_SECRET=__在本机填写__
