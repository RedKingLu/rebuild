# rebuild backend — environment configuration (example)
# Copy to .env and fill in values for local development.
# 端口标准（单一事实源）：文档/02-架构设计/06-容器化部署与执行隔离规范.md §1.1
#   后端 uvicorn 统一 8000（dev 与容器一致，废弃 8765）；前端 dev=5173 / 容器=8080。

# Data directory for in-memory/mock storage (R4)
REBUILD_DATA_DIR=./.data

# CORS origins (comma-separated) — 同时允许 dev(5173) 与容器(8080) 前端
REBUILD_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Debug mode
REBUILD_DEBUG=true

# ── GitHub OAuth（可选）──
# redirect_uri 两套拓扑相同（后端都在 8000），GitHub OAuth App 注册一次即可：
# REBUILD_GITHUB_CLIENT_ID=__fill_locally__
# REBUILD_GITHUB_CLIENT_SECRET=__fill_locally__
# REBUILD_GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/git/oauth/github/callback
# REBUILD_FRONTEND_URL=http://localhost:5173   # 本地 dev；容器部署改 8080

# No real model keys are stored here.
# R4 does NOT connect to real model providers.
# Model keys will be configured in R5+ via REBUILD_MODEL_PROVIDERS_JSON.
